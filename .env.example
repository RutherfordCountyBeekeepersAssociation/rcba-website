# Square payment links
# Copy this file to .env and fill in the real URLs for local development.
# In Lovable, these are configured as project secrets and injected at build time.
VITE_SQUARE_NEW_MEMBER_URL=https://square.link/u/YOUR_NEW_MEMBER_LINK
VITE_SQUARE_RENEWAL_URL=https://square.link/u/YOUR_RENEWAL_LINK
VITE_SQUARE_DONATION_URL=https://square.link/u/YOUR_DONATION_LINK
